<%- include('partials/head', { title: 'Add User' }) %>
<%- include('partials/navbar') %>

<div class="page-header">
    <div>
        <div class="page-title"><i class="fas fa-user-plus me-2" style="color:var(--brand);"></i>Add New User</div>
        <div class="page-subtitle">Create a new system account</div>
    </div>
    <a href="/admin" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Back to Admin</a>
</div>

<%- include('partials/alerts', { success, error, errors: null }) %>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="section-card">
            <div class="section-header"><span class="section-title">User Details</span></div>
            <div class="section-body">
                <form method="POST" action="/register">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">First Name *</label>
                            <input type="text" class="form-control" name="first_name" required value="<%= formValues.first_name || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name *</label>
                            <input type="text" class="form-control" name="last_name" required value="<%= formValues.last_name || '' %>">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Username *</label>
                        <input type="text" class="form-control" name="username" required value="<%= formValues.username || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input type="email" class="form-control" name="email" required value="<%= formValues.email || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password *</label>
                        <input type="password" class="form-control" name="password" required minlength="8">
                        <div class="form-text">At least 8 characters</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <select class="form-select" name="department">
                            <option value="">Select Department</option>
                            <% departments.forEach(dept => { %>
                            <option value="<%= dept.name %>" <%= formValues.department===dept.name?'selected':'' %>><%= dept.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Role *</label>
                        <select class="form-select" name="role">
                            <option value="user" <%= formValues.role==='user'?'selected':'' %>>User</option>
                            <option value="it_staff" <%= formValues.role==='it_staff'?'selected':'' %>>IT Staff</option>
                            <option value="admin" <%= formValues.role==='admin'?'selected':'' %>>Admin</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-user-plus me-1"></i>Create User</button>
                        <a href="/admin" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
</body></html>
