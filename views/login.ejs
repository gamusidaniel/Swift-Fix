<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login | Swift Fix</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<style>
:root{--brand:rgb(0,114,188);--brand-dark:rgb(0,90,155);--brand-light:rgba(0,114,188,.08);--surface:#fff;--surface-2:#f6f8fa;--border:#e4e8ed;--text-1:#0d1117;--text-2:#57606a;--text-3:#8c959f;--radius:8px;--radius-lg:12px;--danger:#cf222e;--danger-bg:#ffebe9;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{font-size:14px;}
body{font-family:'DM Sans',-apple-system,sans-serif;background:var(--surface-2);min-height:100vh;display:flex;flex-direction:column;}
.login-topbar{background:var(--brand);padding:0 32px;height:60px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 12px rgba(0,114,188,.25);flex-shrink:0;}
.login-topbar-brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:#fff;}
.login-topbar-brand img{height:38px;object-fit:contain;}
.topbar-title{font-size:1rem;font-weight:700;}
.topbar-sub{font-size:.72rem;opacity:.8;}
.login-main{flex:1;display:flex;align-items:stretch;min-height:calc(100vh - 60px);}
.form-side{width:460px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;}
.form-inner{flex:1;padding:52px 44px;display:flex;flex-direction:column;justify-content:center;}
.form-footer-bar{padding:16px 44px;border-top:1px solid var(--border);font-size:.74rem;color:var(--text-3);text-align:center;}
.form-footer-bar a{color:var(--brand);text-decoration:none;}
.login-heading{margin-bottom:32px;}
.login-heading h2{font-size:1.4rem;font-weight:800;color:var(--text-1);letter-spacing:-.01em;margin-bottom:4px;}
.login-heading p{font-size:.83rem;color:var(--text-2);}
.login-alert{background:var(--danger-bg);border:1px solid #ffa8a8;color:var(--danger);border-radius:var(--radius-lg);padding:11px 14px;font-size:.82rem;display:flex;align-items:center;gap:9px;margin-bottom:20px;}
.form-label{font-size:.8rem;font-weight:600;color:var(--text-2);margin-bottom:5px;display:block;}
.input-wrap{position:relative;}
.input-wrap .iicon{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--text-3);font-size:.8rem;pointer-events:none;}
.input-wrap input{width:100%;padding:9px 38px 9px 34px;border:1.5px solid var(--border);border-radius:var(--radius);font-family:'DM Sans',sans-serif;font-size:.88rem;color:var(--text-1);background:var(--surface);outline:none;transition:border-color .15s,box-shadow .15s;}
.input-wrap input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(0,114,188,.12);}
.input-wrap input::placeholder{color:var(--text-3);}
.pw-toggle{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-3);cursor:pointer;font-size:.8rem;padding:4px;}
.pw-toggle:hover{color:var(--text-1);}
.btn-login{width:100%;padding:10px;background:var(--brand);color:#fff;border:none;border-radius:var(--radius);font-family:'DM Sans',sans-serif;font-size:.92rem;font-weight:700;cursor:pointer;transition:background .15s,transform .1s;display:flex;align-items:center;justify-content:center;gap:8px;}
.btn-login:hover{background:var(--brand-dark);transform:translateY(-1px);}
.admin-note{margin-top:20px;padding:12px 14px;background:var(--brand-light);border:1px solid rgba(0,114,188,.15);border-radius:var(--radius-lg);font-size:.79rem;color:var(--text-2);display:flex;align-items:flex-start;gap:9px;}
.admin-note i{color:var(--brand);flex-shrink:0;margin-top:1px;}
.hero-side{flex:1;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:60px 64px;}
.hero-bg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center;z-index:1;}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,114,188,.82),rgba(0,90,155,.90));z-index:2;}
.hero-content{position:relative;z-index:4;color:#fff;max-width:480px;}
.hero-logo-icon{width:56px;height:56px;border-radius:var(--radius-lg);background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:1.6rem;margin-bottom:28px;}
.hero-content h1{font-size:2.5rem;font-weight:700;line-height:1.2;margin-bottom:1rem;}
.hero-content p{font-size:1.1rem;opacity:.9;line-height:1.6;margin-bottom:2rem;}
.feat-item{display:flex;align-items:center;gap:12px;margin-bottom:1rem;}
.feat-icon{font-size:1.1rem;color:rgba(255,255,255,.9);flex-shrink:0;width:24px;text-align:center;}
.feat-title{font-size:.95rem;font-weight:400;}
@media(max-width:991px){.login-main{flex-direction:column;}.form-side{width:100%;border-right:none;border-bottom:1px solid var(--border);}.hero-side{min-height:350px;padding:36px 28px;}.form-inner{padding:32px 24px;}.form-footer-bar{padding:14px 24px;}.hero-content h1{font-size:1.75rem;}}
</style>
</head>
<body>

<header class="login-topbar">
    <a href="/login" class="login-topbar-brand">
        <img src="/public/img/rka.png" alt="Logo">
        <div>
            <div class="topbar-title">Swift Fix</div>
            <div class="topbar-sub">Enterprise Support Portal</div>
        </div>
    </a>
    <div style="font-size:.75rem;color:rgba(255,255,255,.8);display:flex;align-items:center;gap:6px;">
        <i class="fas fa-shield-alt"></i> Secure Login
    </div>
</header>

<div class="login-main">
    <div class="form-side">
        <div class="form-inner">
            <div class="login-heading">
                <h2>Welcome back</h2>
                <p>Sign in with your company credentials to continue</p>
            </div>

            <% if (error) { %>
            <div class="login-alert">
                <i class="fas fa-exclamation-circle"></i>
                <%= error %>
            </div>
            <% } %>

            <form method="POST" action="/login">
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <div class="input-wrap">
                        <i class="fas fa-user iicon"></i>
                        <input type="text" name="username" id="username" required autocomplete="username" placeholder="Enter your username">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock iicon"></i>
                        <input type="password" name="password" id="password" required autocomplete="current-password" placeholder="Enter your password">
                        <button type="button" class="pw-toggle" onclick="togglePw()"><i class="fas fa-eye" id="pwIcon"></i></button>
                    </div>
                </div>
                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt"></i> Login to Dashboard
                </button>
            </form>

            <div class="admin-note">
                <i class="fas fa-info-circle"></i>
                <div><strong>No account?</strong> Accounts are created by the system administrator. Contact your IT admin to request access or reset your password.</div>
            </div>
        </div>
        <div class="form-footer-bar">
            &copy; <script>document.write(new Date().getFullYear())</script> Swift Fix
        </div>
    </div>

    <div class="hero-side">
        <img src="/public/img/IT.jpg" alt="" class="hero-bg-img">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-logo-icon"><i class="fas fa-headset"></i></div>
            <h1>Streamline Your IT Support with Swift Fix</h1>
            <p>A professional ticketing system with real-time tracking, SLA compliance, and seamless team collaboration.</p>
            <div class="feat-item"><div class="feat-icon"><i class="fas fa-rocket"></i></div><div class="feat-title">Fast Ticket Submission</div></div>
            <div class="feat-item"><div class="feat-icon"><i class="fas fa-bell"></i></div><div class="feat-title">Real-time Notifications</div></div>
            <div class="feat-item"><div class="feat-icon"><i class="fas fa-shield-alt"></i></div><div class="feat-title">SLA Compliance</div></div>
            <div class="feat-item"><div class="feat-icon"><i class="fas fa-lock"></i></div><div class="feat-title">Secure Platform</div></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById('username')?.focus();
function togglePw(){
    const i=document.getElementById('password'),ic=document.getElementById('pwIcon');
    i.type=i.type==='password'?'text':'password';
    ic.className=i.type==='password'?'fas fa-eye':'fas fa-eye-slash';
}
</script>
</body>
</html>
