<%- include('../partials/head', { title: 'Edit Ticket' }) %>
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs5.min.css" rel="stylesheet">
<%- include('../partials/navbar') %>

<div class="page-header">
    <div>
        <div class="page-title"><i class="fas fa-edit me-2" style="color:var(--brand);"></i>Edit Ticket</div>
        <div class="page-subtitle"><%= ticket.ticket_number %></div>
    </div>
    <a href="/tickets/<%= ticket.id %>" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Back</a>
</div>

<%- include('../partials/alerts', { success: null, error: null, errors }) %>

<div class="section-card">
    <div class="section-header"><span class="section-title">Ticket Details</span></div>
    <div class="section-body">
        <form method="POST" action="/tickets/<%= ticket.id %>/edit">
            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label class="form-label">Title *</label>
                    <input type="text" class="form-control" name="title" required minlength="5" maxlength="200" value="<%= ticket.title %>">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category *</label>
                    <select class="form-select" name="category" required>
                        <% CATEGORIES.forEach(cat => { %>
                        <option value="<%= cat %>" <%= ticket.category===cat?'selected':'' %>><%= cat.charAt(0).toUpperCase()+cat.slice(1) %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Description *</label>
                <textarea class="form-control" name="description" id="description" rows="7" required><%= ticket.description %></textarea>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Priority *</label>
                    <select class="form-select" name="priority" required>
                        <% PRIORITIES.forEach(p => { %>
                        <option value="<%= p %>" <%= ticket.priority===p?'selected':'' %>><%= p.charAt(0).toUpperCase()+p.slice(1) %></option>
                        <% }) %>
                    </select>
                </div>
                <% if (isITStaff) { %>
                <div class="col-md-6">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <% STATUSES.forEach(s => { %>
                        <option value="<%= s %>" <%= ticket.status===s?'selected':'' %>><%= s.replace('_',' ') %></option>
                        <% }) %>
                    </select>
                </div>
                <% } %>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3" style="border-top:1px solid var(--border);">
                <a href="/tickets/<%= ticket.id %>" class="btn btn-outline-secondary"><i class="fas fa-times me-1"></i>Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Changes</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs5.min.js"></script>
<script>$(()=>{ $('#description').summernote({ height:220, toolbar:[['style',['bold','italic','underline','clear']],['para',['ul','ol']],['insert',['link']],['view',['fullscreen','codeview']]] }); });</script>
</body></html>
