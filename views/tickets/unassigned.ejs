<%- include('../partials/head', { title: 'Unassigned Tickets' }) %>
<%- include('../partials/navbar') %>

<div class="page-header">
    <div>
        <div class="page-title"><i class="fas fa-inbox me-2" style="color:var(--brand);"></i>Unassigned Tickets</div>
        <div class="page-subtitle">Open tickets waiting for an owner</div>
    </div>
    <a href="/tickets/assigned" class="btn btn-outline-secondary"><i class="fas fa-tasks me-1"></i> My Assigned</a>
</div>

<%- include('../partials/alerts', { success, error, errors: null }) %>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6"><div class="stat-card c-blue"><div><div class="stat-label">Total Unassigned</div><div class="stat-value"><%= totalUnassigned %></div></div><div class="stat-icon-wrap si-blue"><i class="fas fa-inbox"></i></div></div></div>
    <div class="col-xl-3 col-sm-6"><div class="stat-card c-slate"><div><div class="stat-label">Urgent</div><div class="stat-value"><%= priorityCounts.urgent || 0 %></div></div><div class="stat-icon-wrap si-slate"><i class="fas fa-bolt"></i></div></div></div>
    <div class="col-xl-3 col-sm-6"><div class="stat-card c-amber"><div><div class="stat-label">High</div><div class="stat-value"><%= priorityCounts.high || 0 %></div></div><div class="stat-icon-wrap si-amber"><i class="fas fa-exclamation"></i></div></div></div>
    <div class="col-xl-3 col-sm-6"><div class="stat-card c-green"><div><div class="stat-label">Medium + Low</div><div class="stat-value"><%= (priorityCounts.medium||0) + (priorityCounts.low||0) %></div></div><div class="stat-icon-wrap si-green"><i class="fas fa-list"></i></div></div></div>
</div>

<div class="section-card mb-4">
    <div class="section-body" style="padding:14px 20px;">
        <form method="GET" action="/tickets/unassigned" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Priority</label>
                <select name="priority" class="form-select form-select-sm">
                    <option value="all" <%= filters.priority==='all'?'selected':'' %>>All Priorities</option>
                    <% PRIORITIES.forEach(p => { %><option value="<%= p %>" <%= filters.priority===p?'selected':'' %>><%= p %></option><% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select name="category" class="form-select form-select-sm">
                    <option value="all" <%= filters.category==='all'?'selected':'' %>>All Categories</option>
                    <% CATEGORIES.forEach(c => { %><option value="<%= c %>" <%= filters.category===c?'selected':'' %>><%= c %></option><% }) %>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control form-control-sm" value="<%= filters.search %>" placeholder="Title, ticket #, or requester">
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="fas fa-filter me-1"></i>Filter</button></div>
        </form>
    </div>
</div>

<div class="section-card mb-4">
    <div class="section-header"><span class="section-title">Tickets (<%= tickets.length %>)</span></div>
    <% if (tickets.length === 0) { %>
    <div class="empty-state"><i class="fas fa-check-circle"></i><h5>Nothing unassigned right now</h5></div>
    <% } else { %>
    <div class="tbl-wrap">
        <table class="ms-table" id="unassignedTable">
            <thead><tr><th>Ticket #</th><th>Title</th><th>Requester</th><th>Category</th><th>Priority</th><th>Created</th><th></th></tr></thead>
            <tbody>
                <% tickets.forEach(t => { %>
                <tr>
                    <td><span class="ticket-num"><%= t.ticket_number %></span></td>
                    <td><a href="/tickets/<%= t.id %>" class="ticket-link"><%= t.title %></a></td>
                    <td><%= t.requester_first_name %> <%= t.requester_last_name %></td>
                    <td><span class="cat-pill"><%= t.category %></span></td>
                    <td><span class="badge-pill p-<%= t.priority %>"><%= t.priority %></span></td>
                    <td style="white-space:nowrap;"><%= new Date(t.created_at).toLocaleDateString() %></td>
                    <td>
                        <form method="POST" action="/tickets/unassigned/self-assign" class="d-inline">
                            <input type="hidden" name="ticket_id" value="<%= t.id %>">
                            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-hand-paper me-1"></i>Assign to Me</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
<script>$(()=>{ if ($('#unassignedTable').length) $('#unassignedTable').DataTable({ pageLength:25, order:[[4,'asc']] }); });</script>
</body></html>
